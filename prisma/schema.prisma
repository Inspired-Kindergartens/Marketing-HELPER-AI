generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GeneralChatGroup {
  id            Int                       @id @default(autoincrement())
  name          String
  position      Int                       @default(0)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  conversations GeneralChatConversation[]

  @@index([position, name])
}

model GeneralChatConversation {
  id        Int                  @id @default(autoincrement())
  groupId   Int?
  title     String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  group     GeneralChatGroup?    @relation(fields: [groupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  messages  GeneralChatMessage[]

  @@index([groupId, updatedAt(sort: Desc)])
  @@index([updatedAt(sort: Desc)])
}

model GeneralChatMessage {
  id             Int                     @id @default(autoincrement())
  conversationId Int
  role           String
  content        String
  createdAt      DateTime                @default(now())
  conversation   GeneralChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([conversationId, createdAt])
}

model ExternalApiCapture {
  id             BigInt   @id @default(autoincrement())
  source         String
  operation      String
  receivedAt     DateTime
  httpStatus     Int?
  outcome        String
  requestContext Json?
  payload        Json
  createdAt      DateTime @default(now())

  @@index([source, receivedAt(sort: Desc)])
  @@index([operation, receivedAt(sort: Desc)])
  @@index([outcome, receivedAt(sort: Desc)])
}

model CentreReference {
  id                             Int                             @id @default(autoincrement())
  centreKey                      Int                             @unique
  name                           String
  openStatus                     String
  licenseNumber                  Int?
  regionName                     String?
  areaName                       String?
  subgroupName                   String?
  ignored                        Boolean                         @default(false)
  lastSyncedAt                   DateTime
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  manualCapacity                 ManualCentreCapacity?
  snapshots                      ServiceAnalyticsSnapshot[]
  metaCampaigns                  MetaCampaign[]
  metaAdSets                     MetaAdSet[]
  metaAds                        MetaAd[]
  metaInsights                   MetaInsightSnapshot[]
  metaEmailContent               MetaEmailContent?
  postmarkOutboundSnapshotsByTag PostmarkOutboundSnapshotByTag[]
  postmarkMessageEvents          PostmarkMessageEvent[]
  formstackForms                 FormstackForm[]
  formstackSubmissions           FormstackSubmission[]
  projects                       Project[]
  tasks                          Task[]
  jdCentreProfile                JdCentreProfile?
  jobDescriptions                JobDescription[]
  jdBlurbs                       JdBlurb[]
  jdKnowledgeDocs                JdKnowledgeDoc[]

  @@index([ignored, openStatus, name])
}

model MetaEmailContent {
  id          Int             @id @default(autoincrement())
  centreKey   Int             @unique
  headingText String          @default("")
  primaryText String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  centre      CentreReference @relation(fields: [centreKey], references: [centreKey], onDelete: Cascade, onUpdate: Cascade)

  @@index([updatedAt(sort: Desc)])
}

model ManualCentreCapacity {
  id               Int             @id @default(autoincrement())
  centreKey        Int             @unique
  licensedCapacity Int
  maxU2            Int?
  maxO2            Int?
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  centre           CentreReference @relation(fields: [centreKey], references: [centreKey], onDelete: Cascade, onUpdate: Cascade)
}

model AnalyticsSnapshotRun {
  id        Int                        @id @default(autoincrement())
  runDate   DateTime
  source    String                     @default("manual")
  createdAt DateTime                   @default(now())
  snapshots ServiceAnalyticsSnapshot[]

  @@index([runDate(sort: Desc)])
}

model ServiceAnalyticsSnapshot {
  id                                Int                  @id @default(autoincrement())
  runId                             Int
  centreKey                         Int
  serviceName                       String
  date                              DateTime
  enrolledCount                     Int
  enrolledFteCount                  Decimal              @default(0) @db.Decimal(8, 4)
  bookedAverageDailyCount           Decimal              @default(0) @db.Decimal(8, 4)
  bookedUtilisationRatio            Decimal              @default(0) @db.Decimal(8, 4)
  enrolledUnder2Count               Int                  @default(0)
  enrolledOver2Count                Int                  @default(0)
  licensedCapacity                  Int
  licensedUnder2Capacity            Int?
  licensedOver2Capacity             Int?
  enrolmentRatio                    Decimal              @db.Decimal(8, 4)
  waitlistCount                     Int
  waitlistUnder2Count               Int                  @default(0)
  waitlistUnder5Count               Int                  @default(0)
  waitlistTurning5ThisYearCount     Int                  @default(0)
  waitlistAged5PlusCount            Int                  @default(0)
  waitlistUnknownAgeCount           Int                  @default(0)
  waitlistOldestEntryDays           Int?
  waitlistAverageEntryDays          Decimal?             @db.Decimal(8, 4)
  knownLeavingCount                 Int
  knownLeavingCountsByWindow        Json                 @default("{\"1W\":0,\"2W\":0,\"3W\":0,\"1M\":0,\"2M\":0,\"3M\":0,\"6M\":0,\"12M\":0}")
  agedOutCount                      Int
  approachingFiveCount              Int
  approachingFiveCountsByWindow     Json                 @default("{\"1W\":0,\"2W\":0,\"3W\":0,\"1M\":0,\"2M\":0,\"3M\":0,\"6M\":0,\"12M\":0}")
  replacementPressureCountsByWindow Json                 @default("{\"1W\":0,\"2W\":0,\"3W\":0,\"1M\":0,\"2M\":0,\"3M\":0,\"6M\":0,\"12M\":0}")
  replacementPressure               Int
  waitlistCoverRatio                Decimal              @db.Decimal(8, 4)
  urgencyScore                      Decimal              @db.Decimal(8, 4)
  urgencyBand                       String
  createdAt                         DateTime             @default(now())
  centre                            CentreReference      @relation(fields: [centreKey], references: [centreKey], onDelete: Restrict, onUpdate: Cascade)
  run                               AnalyticsSnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([runId, centreKey])
  @@index([runId, urgencyScore(sort: Desc)])
  @@index([centreKey, date(sort: Desc)])
}

model MetaAdAccount {
  id              Int                   @id @default(autoincrement())
  metaAdAccountId String                @unique
  accountId       String?
  name            String
  accountStatus   Int?
  currency        String?
  timezoneName    String?
  pulledAt        DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  campaigns       MetaCampaign[]
  adSets          MetaAdSet[]
  ads             MetaAd[]
  insights        MetaInsightSnapshot[]

  @@index([metaAdAccountId])
  @@index([pulledAt(sort: Desc)])
}

model MetaCampaign {
  id              Int                   @id @default(autoincrement())
  metaCampaignId  String                @unique
  metaAdAccountId String
  centreKey       Int?
  name            String
  status          String?
  effectiveStatus String?
  objective       String?
  metaCreatedTime DateTime?
  metaUpdatedTime DateTime?
  pulledAt        DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  adAccount       MetaAdAccount         @relation(fields: [metaAdAccountId], references: [metaAdAccountId], onDelete: Cascade, onUpdate: Cascade)
  centre          CentreReference?      @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)
  adSets          MetaAdSet[]
  ads             MetaAd[]
  insights        MetaInsightSnapshot[]

  @@index([metaAdAccountId])
  @@index([metaCampaignId])
  @@index([centreKey])
  @@index([pulledAt(sort: Desc)])
}

model MetaAdSet {
  id               Int                   @id @default(autoincrement())
  metaAdSetId      String                @unique
  metaCampaignId   String
  metaAdAccountId  String
  centreKey        Int?
  name             String
  status           String?
  effectiveStatus  String?
  optimizationGoal String?
  dailyBudget      String?
  lifetimeBudget   String?
  startTime        DateTime?
  endTime          DateTime?
  metaCreatedTime  DateTime?
  metaUpdatedTime  DateTime?
  pulledAt         DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  adAccount        MetaAdAccount         @relation(fields: [metaAdAccountId], references: [metaAdAccountId], onDelete: Cascade, onUpdate: Cascade)
  campaign         MetaCampaign          @relation(fields: [metaCampaignId], references: [metaCampaignId], onDelete: Cascade, onUpdate: Cascade)
  centre           CentreReference?      @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)
  ads              MetaAd[]
  insights         MetaInsightSnapshot[]

  @@index([metaAdAccountId])
  @@index([metaCampaignId])
  @@index([metaAdSetId])
  @@index([centreKey])
  @@index([pulledAt(sort: Desc)])
}

model MetaAd {
  id              Int                   @id @default(autoincrement())
  metaAdId        String                @unique
  metaAdSetId     String?
  metaCampaignId  String?
  metaAdAccountId String
  centreKey       Int?
  name            String
  status          String?
  effectiveStatus String?
  metaCreatedTime DateTime?
  metaUpdatedTime DateTime?
  pulledAt        DateTime
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  adAccount       MetaAdAccount         @relation(fields: [metaAdAccountId], references: [metaAdAccountId], onDelete: Cascade, onUpdate: Cascade)
  campaign        MetaCampaign?         @relation(fields: [metaCampaignId], references: [metaCampaignId], onDelete: SetNull, onUpdate: Cascade)
  adSet           MetaAdSet?            @relation(fields: [metaAdSetId], references: [metaAdSetId], onDelete: SetNull, onUpdate: Cascade)
  centre          CentreReference?      @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)
  insights        MetaInsightSnapshot[]

  @@index([metaAdAccountId])
  @@index([metaCampaignId])
  @@index([metaAdSetId])
  @@index([metaAdId])
  @@index([centreKey])
  @@index([pulledAt(sort: Desc)])
}

model MetaInsightSnapshot {
  id              Int              @id @default(autoincrement())
  pulledAt        DateTime
  insightDate     DateTime
  level           String
  metaAdAccountId String
  metaCampaignId  String?
  metaAdSetId     String?
  metaAdId        String?
  centreKey       Int?
  campaignName    String?
  adSetName       String?
  adName          String?
  impressions     Int?
  reach           Int?
  clicks          Int?
  spend           Decimal?         @db.Decimal(18, 6)
  cpc             Decimal?         @db.Decimal(18, 6)
  cpm             Decimal?         @db.Decimal(18, 6)
  ctr             Decimal?         @db.Decimal(18, 6)
  frequency       Decimal?         @db.Decimal(18, 6)
  rawActions      Json?
  raw             Json?
  createdAt       DateTime         @default(now())
  adAccount       MetaAdAccount    @relation(fields: [metaAdAccountId], references: [metaAdAccountId], onDelete: Cascade, onUpdate: Cascade)
  campaign        MetaCampaign?    @relation(fields: [metaCampaignId], references: [metaCampaignId], onDelete: SetNull, onUpdate: Cascade)
  adSet           MetaAdSet?       @relation(fields: [metaAdSetId], references: [metaAdSetId], onDelete: SetNull, onUpdate: Cascade)
  ad              MetaAd?          @relation(fields: [metaAdId], references: [metaAdId], onDelete: SetNull, onUpdate: Cascade)
  centre          CentreReference? @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)

  @@index([metaAdAccountId])
  @@index([metaCampaignId])
  @@index([metaAdSetId])
  @@index([metaAdId])
  @@index([centreKey])
  @@index([pulledAt(sort: Desc)])
  @@index([insightDate(sort: Desc)])
  @@index([level, insightDate(sort: Desc)])
}

model MetaRecommendationNote {
  id             Int       @id @default(autoincrement())
  notificationId String
  text           String
  submittedAt    DateTime  @default(now())
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([notificationId, submittedAt(sort: Desc)])
  @@index([deletedAt])
}

model MetaRecommendationNotification {
  id                  Int       @id @default(autoincrement())
  notificationId      String    @unique
  centreKey           Int
  centreName          String
  windowKey           String
  recommendation      String
  message             String
  priority            Int
  openPlaces          Int
  actionableWaitlist  Int
  waitlistCount       Int
  replacementPressure Int
  activeCampaignCount Int
  spend30d            Decimal   @default(0) @db.Decimal(18, 6)
  firstSeenAt         DateTime  @default(now())
  lastSeenAt          DateTime  @default(now())
  dismissedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([centreKey, lastSeenAt(sort: Desc)])
  @@index([dismissedAt])
  @@index([lastSeenAt(sort: Desc)])
}

model GoogleAnalyticsDailySnapshot {
  id                     Int                           @id @default(autoincrement())
  propertyId             String
  snapshotDate           DateTime
  rangeStartDate         DateTime
  rangeEndDate           DateTime
  pulledAt               DateTime
  activeUsers            Int?
  sessions               Int?
  engagedSessions        Int?
  screenPageViews        Int?
  conversions            Decimal?                      @db.Decimal(18, 6)
  totalRevenue           Decimal?                      @db.Decimal(18, 6)
  engagementRate         Decimal?                      @db.Decimal(18, 6)
  averageSessionDuration Decimal?                      @db.Decimal(18, 6)
  raw                    Json?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  pages                  GoogleAnalyticsPageSnapshot[]

  @@index([propertyId, snapshotDate(sort: Desc)])
  @@index([propertyId, rangeStartDate, rangeEndDate])
  @@index([pulledAt(sort: Desc)])
}

model GoogleAnalyticsPageSnapshot {
  id              Int                          @id @default(autoincrement())
  snapshotId      Int
  propertyId      String
  snapshotDate    DateTime
  rangeStartDate  DateTime
  rangeEndDate    DateTime
  pagePath        String
  pageTitle       String?
  activeUsers     Int?
  sessions        Int?
  screenPageViews Int?
  engagementRate  Decimal?                     @db.Decimal(18, 6)
  raw             Json?
  createdAt       DateTime                     @default(now())
  snapshot        GoogleAnalyticsDailySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([snapshotId, pagePath])
  @@index([propertyId, snapshotDate(sort: Desc)])
  @@index([propertyId, rangeStartDate, rangeEndDate])
  @@index([snapshotId, screenPageViews(sort: Desc)])
}

model PostmarkOutboundSnapshot {
  id             Int      @id @default(autoincrement())
  serverToken    String
  snapshotDate   DateTime
  rangeStartDate DateTime
  rangeEndDate   DateTime
  pulledAt       DateTime
  sent           Int      @default(0)
  delivered      Int      @default(0)
  opened         Int      @default(0)
  uniqueOpened   Int      @default(0)
  clicked        Int      @default(0)
  uniqueClicked  Int      @default(0)
  bounced        Int      @default(0)
  spamComplained Int      @default(0)
  suppressed     Int      @default(0)
  raw            Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([serverToken, snapshotDate(sort: Desc)])
  @@index([pulledAt(sort: Desc)])
}

model PostmarkOutboundSnapshotByTag {
  id             Int              @id @default(autoincrement())
  serverToken    String
  tag            String
  centreKey      Int?
  snapshotDate   DateTime
  rangeStartDate DateTime
  rangeEndDate   DateTime
  pulledAt       DateTime
  sent           Int              @default(0)
  delivered      Int              @default(0)
  opened         Int              @default(0)
  uniqueOpened   Int              @default(0)
  clicked        Int              @default(0)
  uniqueClicked  Int              @default(0)
  bounced        Int              @default(0)
  spamComplained Int              @default(0)
  raw            Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  centre         CentreReference? @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)

  @@index([serverToken, tag, snapshotDate(sort: Desc)])
  @@index([centreKey, snapshotDate(sort: Desc)])
  @@index([pulledAt(sort: Desc)])
}

model PostmarkMessageEvent {
  id          Int              @id @default(autoincrement())
  serverToken String
  messageId   String
  eventType   String
  recipient   String?
  tag         String?
  centreKey   Int?
  occurredAt  DateTime
  receivedAt  DateTime
  raw         Json?
  createdAt   DateTime         @default(now())
  centre      CentreReference? @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)

  @@unique([serverToken, messageId, eventType, occurredAt])
  @@index([serverToken, occurredAt(sort: Desc)])
  @@index([centreKey, occurredAt(sort: Desc)])
  @@index([tag, occurredAt(sort: Desc)])
}

// Persisted cursor for incremental pulls from external sources (e.g. the
// Cloudflare Worker that buffers Postmark webhooks while this app is offline).
// `lastId` is the highest source event id already ingested locally.
model SyncCursor {
  key       String   @id
  lastId    BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

model MailchimpCampaign {
  id           Int                       @id @default(autoincrement())
  mailchimpId  String                    @unique
  serverPrefix String
  listId       String?
  subject      String                    @default("")
  previewText  String                    @default("")
  status       String?
  type         String?
  archiveUrl   String?
  sendTime     DateTime?
  emailsSent   Int                       @default(0)
  pulledAt     DateTime
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  reports      MailchimpCampaignReport[]

  @@index([serverPrefix, sendTime(sort: Desc)])
  @@index([listId, sendTime(sort: Desc)])
  @@index([pulledAt(sort: Desc)])
}

model MailchimpCampaignReport {
  id           Int               @id @default(autoincrement())
  mailchimpId  String
  opens        Int               @default(0)
  uniqueOpens  Int               @default(0)
  openRate     Decimal           @default(0) @db.Decimal(18, 6)
  clicks       Int               @default(0)
  uniqueClicks Int               @default(0)
  clickRate    Decimal           @default(0) @db.Decimal(18, 6)
  unsubscribes Int               @default(0)
  bounces      Int               @default(0)
  abuseReports Int               @default(0)
  forwardCount Int               @default(0)
  sendTime     DateTime?
  fetchedAt    DateTime
  raw          Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  campaign     MailchimpCampaign @relation(fields: [mailchimpId], references: [mailchimpId], onDelete: Cascade, onUpdate: Cascade)

  @@index([sendTime(sort: Desc)])
  @@index([fetchedAt(sort: Desc)])
  @@index([mailchimpId, fetchedAt(sort: Desc)])
}

model MailchimpListGrowthSnapshot {
  id           Int      @id @default(autoincrement())
  serverPrefix String
  listId       String
  snapshotDate DateTime
  memberCount  Int      @default(0)
  subscribed   Int      @default(0)
  unsubscribed Int      @default(0)
  cleaned      Int      @default(0)
  pending      Int      @default(0)
  pulledAt     DateTime
  raw          Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([listId, snapshotDate(sort: Desc)])
  @@index([serverPrefix, listId, snapshotDate(sort: Desc)])
  @@index([pulledAt(sort: Desc)])
}

model FormstackForm {
  id               Int                   @id @default(autoincrement())
  formstackId      String                @unique
  name             String                @default("")
  formUrl          String?
  folder           String?
  centreKey        Int?
  submissionCount  Int                   @default(0)
  viewCount        Int?
  lastSubmissionAt DateTime?
  pulledAt         DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  centre           CentreReference?      @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)
  submissions      FormstackSubmission[]

  @@index([centreKey, lastSubmissionAt(sort: Desc)])
  @@index([folder])
  @@index([pulledAt(sort: Desc)])
}

model FormstackSubmission {
  id              Int              @id @default(autoincrement())
  formstackId     String           @unique
  formFormstackId String
  centreKey       Int?
  submittedAt     DateTime
  payload         Json
  syncCursor      String?
  pulledAt        DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  form            FormstackForm    @relation(fields: [formFormstackId], references: [formstackId], onDelete: Cascade, onUpdate: Cascade)
  centre          CentreReference? @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)

  @@index([formFormstackId, submittedAt(sort: Desc)])
  @@index([centreKey, submittedAt(sort: Desc)])
  @@index([submittedAt(sort: Desc)])
  @@index([pulledAt(sort: Desc)])
}

// User-maintained directory of people who can be assigned to tasks and added to
// projects. Distinct from any login/auth concept — the app has no user accounts.
model Member {
  id             Int             @id @default(autoincrement())
  name           String
  email          String?         @unique
  role           String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projectMembers ProjectMember[]
  assignedTasks  Task[]

  @@index([active, name])
}

model Project {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  status      String           @default("active")
  startDate   DateTime?
  targetDate  DateTime?
  centreKey   Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  centre      CentreReference? @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)
  members     ProjectMember[]
  taskGroups  TaskGroup[]
  tasks       Task[]

  @@index([status, targetDate])
  @@index([centreKey])
}

model ProjectMember {
  id          Int      @id @default(autoincrement())
  projectId   Int
  memberId    Int
  projectRole String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([projectId, memberId])
  @@index([memberId])
}

model TaskGroup {
  id        Int      @id @default(autoincrement())
  projectId Int
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tasks     Task[]

  @@index([projectId, position])
}

model Task {
  id               Int                  @id @default(autoincrement())
  title            String
  description      String?
  status           String               @default("todo")
  dueDate          DateTime?
  estimatedMinutes Int?
  loggedMinutes    Int                  @default(0)
  timerStartedAt   DateTime?
  projectId        Int?
  taskGroupId      Int?
  centreKey        Int?
  assigneeId       Int?
  position         Int                  @default(0)
  completedAt      DateTime?
  // Last composed email draft for this task (reused as the editor's starting
  // point next time; the actual send happens via a mailto: link to Outlook).
  emailSubject     String?
  emailBody        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  project          Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  group            TaskGroup?           @relation(fields: [taskGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  centre           CentreReference?     @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)
  assignee         Member?              @relation(fields: [assigneeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  checklistItems   ChecklistItem[]
  emailRecipients  TaskEmailRecipient[]
  attachments      TaskAttachment[]
  timeEntries      TimeEntry[]

  @@index([status, dueDate])
  @@index([projectId, position])
  @@index([taskGroupId, position])
  @@index([assigneeId])
  @@index([centreKey])
  @@index([dueDate])
}

model TaskAttachment {
  id           Int      @id @default(autoincrement())
  taskId       Int
  originalName String
  storedName   String   @unique
  storagePath  String
  mimeType     String?
  sizeBytes    Int
  uploadedAt   DateTime @default(now())
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([taskId, uploadedAt(sort: Desc)])
}

// Recipients previously used when composing an email from a task. Drives the
// "quick select" chips and the placeholder (most recently used) in the compose
// editor. Distinct from the read-only centre-contact list and the Member
// directory, which only seed the search/autocomplete of new addresses.
model TaskEmailRecipient {
  id         Int      @id @default(autoincrement())
  taskId     Int
  email      String
  name       String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([taskId, email])
  @@index([taskId, lastUsedAt(sort: Desc)])
}

model ChecklistItem {
  id        Int      @id @default(autoincrement())
  taskId    Int
  label     String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([taskId, position])
}

// Audit trail for time logged against a task. `Task.loggedMinutes` is the cached
// sum, incremented when an entry is written (timer stop or manual log).
model TimeEntry {
  id        Int       @id @default(autoincrement())
  taskId    Int
  minutes   Int
  note      String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([taskId, createdAt(sort: Desc)])
}

// --- Job Descriptions ------------------------------------------------------
// KTCA pay-scale rates by effective date. Selectable-by-date so the salary
// range shown on a JD rolls over automatically as new rate steps take effect
// (see KTCA 2026-2028 schedule in PLAN.md). `step` is null for flat scales
// (K2/K2R).
model JdPayScale {
  id             Int      @id @default(autoincrement())
  scaleKey       String
  step           Int?
  effectiveFrom  DateTime
  annualRate     Decimal  @db.Decimal(10, 2)
  sourceDocument String?
  importedAt     DateTime @default(now())

  @@unique([scaleKey, step, effectiveFrom])
  @@index([scaleKey, effectiveFrom(sort: Desc)])
}

// One row per imported KTCA agreement document. Drives the yearly expiry
// check (warn when `expiresOn` is past or within 90 days).
model JdAgreement {
  id            Int      @id @default(autoincrement())
  name          String
  fileName      String?
  effectiveFrom DateTime
  expiresOn     DateTime
  importedAt    DateTime @default(now())

  @@index([expiresOn(sort: Desc)])
}

// Per-job-title defaults: qualifications, role sections, PDF layout variant,
// and the non-standard "extras" used by the administrator/professional
// layouts (position hours, reports-to, remuneration text, etc). One row per
// dropdown entry in the JD "Job Title" field.
model JdTitleProfile {
  id                  Int              @id @default(autoincrement())
  jobTitle            String           @unique
  sortOrder           Int              @default(0)
  jobCategory         String
  payScaleKey         String?
  layoutVariant       String           @default("standard") // standard | administrator | professional
  defaultPositionType String           @default("Full Time")
  agreementText       String           @default("Kindergarten Teachers Collective Agreement")
  qualificationsText  String
  roleSections        Json // [{ heading, intro?, bullets: [{ text, boldLeadIn? }] }]
  extras              Json? // positionHours, reportsTo, remunerationText, contractManagerName, subjectLine
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  jobDescriptions     JobDescription[]

  @@index([sortOrder])
}

// Per-centre JD defaults, extending CentreReference. Maintained in the JD
// settings panel; seeded initially only for centres with known values.
model JdCentreProfile {
  id                   Int             @id @default(autoincrement())
  centreKey            Int             @unique
  locationDisplay      String // e.g. "PAENGAROA Kindergarten"
  introParagraph       String          @default("")
  seniorTeacherName    String          @default("")
  seniorTeacherAcronym String          @default("")
  isEnviroschool       Boolean         @default(false) // Only true for centres factually registered as Enviroschools — drives the AI blurb prompt so it never invents this claim.
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  centre               CentreReference @relation(fields: [centreKey], references: [centreKey], onDelete: Cascade, onUpdate: Cascade)
}

// A single generated Job Description. Field values are copied from the
// title/centre profiles at creation time so each JD can be edited
// independently afterwards without affecting the shared profile defaults.
model JobDescription {
  id                   Int              @id @default(autoincrement())
  jobTitle             String
  titleProfileId       Int?
  centreKey            Int?
  locationDisplay      String
  positionType         String
  fte                  Decimal?         @db.Decimal(4, 2)
  jobCategory          String
  layoutVariant        String           @default("standard")
  agreementText        String           @default("")
  salaryRangeText      String           @default("")
  dateAdvertised       DateTime?
  closingAt            DateTime?
  startDateText        String           @default("To be negotiated")
  qualificationsText   String           @default("")
  introParagraph       String           @default("")
  roleSections         Json
  extras               Json?
  seniorTeacherName    String           @default("")
  blurbHtml            String?
  reviewedByAcronym    String           @default("")
  approvedByAcronym    String           @default("PM")
  lastUpdatedByAcronym String           @default("")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  titleProfile         JdTitleProfile?  @relation(fields: [titleProfileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  centre               CentreReference? @relation(fields: [centreKey], references: [centreKey], onDelete: SetNull, onUpdate: Cascade)
  blurbs               JdBlurb[]

  @@index([centreKey, createdAt(sort: Desc)])
  @@index([titleProfileId])
}

// Blurb save history: a new row is appended on every save (AI-generated or
// hand-edited) so all prior versions remain available both to restore and as
// future AI reference corpus for that centre.
model JdBlurb {
  id               Int             @id @default(autoincrement())
  centreKey        Int
  jobDescriptionId Int?
  contentHtml      String
  savedAt          DateTime        @default(now())
  centre           CentreReference @relation(fields: [centreKey], references: [centreKey], onDelete: Cascade, onUpdate: Cascade)
  jobDescription   JobDescription? @relation(fields: [jobDescriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([centreKey, savedAt(sort: Desc)])
  @@index([jobDescriptionId, savedAt(sort: Desc)])
}

// Blurb information base for AI context: the IK generic/immovable text
// (kind=generic, centreKey null) plus each centre's current and old website
// blurbs (kind=service). `label` distinguishes "current" / "old" / a doc name.
model JdKnowledgeDoc {
  id          Int              @id @default(autoincrement())
  kind        String // generic | service
  centreKey   Int?
  label       String
  contentHtml String
  updatedAt   DateTime         @updatedAt
  createdAt   DateTime         @default(now())
  centre      CentreReference? @relation(fields: [centreKey], references: [centreKey], onDelete: Cascade, onUpdate: Cascade)

  @@unique([kind, centreKey, label])
  @@index([kind, centreKey])
}
