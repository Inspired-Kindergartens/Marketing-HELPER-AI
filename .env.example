# Every setting the app reads. Copy to .env and fill in. On a transfer the real
# .env travels inside the passphrase-encrypted "Back up data" file; run
# `npm run transfer:check` to see what is missing and to test each service.
# Keep this list in step with SETTINGS in scripts/transfer-check.ts.
#
# Credentials can be typed in as plain text: the app encrypts them in place
# (Windows DPAPI, "dpapi:..." values that only decrypt on this computer) the
# next time it starts, or run `npm run secrets:seal`. See SECRET_KEYS in
# src/secrets.ts for which keys are encrypted.

# --- Infocare (REQUIRED - the app will not start without these) ---
# Change the login from the app's "Infocare Login" page (landing footer); it is
# tested against Infocare before being saved here and is never shown back.
INFOCAREUSER=""
INFOCAREPASS=""
INFOCARE_BASE_URL="https://info-care6.digiweb.net.nz/trfka/servlet/RubyServlet"
# Set automatically when the login is changed in the app.
INFOCARE_LOGIN_UPDATED_AT=""

# --- Server ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Turn on the weekly analytics snapshot job.
AUTO_WEEKLY_SNAPSHOT=false

# --- AI (local Ollama by default) ---
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_CHAT_MODEL=llama3.1:8b
# Set automatically by the "Update AI model" footer button.
AI_CHAT_MODEL_FALLBACK=""
AI_EMBED_MODEL=nomic-embed-text
AI_TIMEOUT_MS=60000

# --- Database (local Postgres, REQUIRED) ---
DATABASE_URL="postgresql://app_local_user:CHANGE_ME@127.0.0.1:5432/app_local_db?schema=public"
SHADOW_DATABASE_URL="postgresql://app_local_user:CHANGE_ME@127.0.0.1:5432/app_shadow_db?schema=public"
# Folder holding pg_dump.exe if it isn't under C:\Program Files\PostgreSQL\<ver>\bin.
# PG_BIN=""

# --- Meta (Facebook/Instagram Ads) ---
# Generate a token at https://developers.facebook.com/tools/explorer/
# (scopes: ads_read, business_management), then extend to 60 days at
# https://developers.facebook.com/tools/debug/accesstoken/ or use a
# System User token from Business Manager for a non-expiring token.
META_USER_ID=""
META_USER_NAME=""
META_AD_ACCOUNT_ID=""
META_ACCESS_TOKEN=""

# --- Google Analytics ---
GOOGLE_ANALYTICS_PROPERTY_ID=""
# OAuth client file from Google Cloud console, and the refresh-token file
# written by `npm run google:oauth`. Both live in the project folder.
GOOGLE_ANALYTICS_OAUTH_PATH="OAuth.json"
GOOGLE_ANALYTICS_TOKEN_PATH="google-oauth-token.json"
# Filled in automatically: on start the app moves the refresh token out of the
# token file above into this (encrypted) setting and deletes the file.
GOOGLE_ANALYTICS_REFRESH_TOKEN=""

# --- Online Communications app (Phase 0) ---
POSTMARK_SERVER_TOKEN=""
# POSTMARK_ACCOUNT_TOKEN="" # optional, only needed for account-wide stats
# Basic-auth password Postmark must present when calling the webhook endpoint.
# Generate with: [Convert]::ToBase64String((1..24 | %{Get-Random -Max 256}))
POSTMARK_WEBHOOK_BASIC_AUTH=""
# Cloudflare Worker that buffers Postmark webhook events while this app is
# offline. The app pulls new events from it hourly and on startup, advancing a
# persisted cursor so nothing is missed or double-counted.
CLOUDFLARE_SYNC_URL="https://postmark-webhook-events.marketing-884.workers.dev"
CLOUDFLARE_SYNC_TOKEN=""
MAILCHIMP_API_KEY=""
# Data-centre prefix from your Mailchimp account (e.g. "us14"). Optional —
# if omitted, it's extracted from the API key suffix.
MAILCHIMP_SERVER_PREFIX=""
FORMSTACK_API_TOKEN=""
