{
  "name": "marketing-helper-ai",
  "version": "1.0.0",
  "description": "Local-only Fastify app with Prisma and PostgreSQL",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc && node scripts/copy-prisma-client.mjs",
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "run:build": "powershell -ExecutionPolicy Bypass -File scripts/run-build-persistent.ps1",
    "server:supervise": "node scripts/server-supervisor.mjs",
    "server:background": "powershell -ExecutionPolicy Bypass -File scripts/start-server-background.ps1",
    "server:install": "powershell -ExecutionPolicy Bypass -File scripts/install-persistent-server-task.ps1",
    "server:task:start": "powershell -ExecutionPolicy Bypass -Command \"Start-ScheduledTask -TaskName 'Marketing Helper AI Server'\"",
    "server:task:stop": "powershell -ExecutionPolicy Bypass -Command \"Stop-ScheduledTask -TaskName 'Marketing Helper AI Server'\"",
    "ai:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-ai.ps1",
    "ai:doctor": "powershell -ExecutionPolicy Bypass -File scripts/ai-doctor.ps1",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "google:oauth": "tsx scripts/google-oauth-token.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/run-tests.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/env": "^6.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "4.5.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
